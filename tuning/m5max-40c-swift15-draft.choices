1280    5120   8    decode  none      splitsums32 40   4
5120    4096   8    decode  none      splitsums32 160  4
5120    17408  8    decode  none      splitsums32 160  4
5120    25600  8    decode  none      splitsums32 160  4
6144    5120   8    decode  none      splitsums32 192  4
17408   5120   8    decode  gateup    deep256  68     8
17408   5120   24   decode  gateup    splitsums32 544  4
17408   5120   32   decode  gateup    splitsums32 544  8
1280    5120   16   decode  none      splitsums32 40   8
6144    5120   16   decode  none      splitsums32 192  8
5120    4096   16   decode  none      splitsums32 160  4
5120    17408  16   decode  none      splitsums32 160  4
5120    25600  16   decode  none      splitsums32 160  4
